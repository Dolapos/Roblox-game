{
  "name": "Game",
  "tree": {
    "$className": "DataModel",

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": {
        "$path": "src/server"
      }
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": {
          "$path": "src/client"
        }
      }
    },

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/shared"
      },
      "Data": {
        "$path": "src/data"
      },
      "Remotes": {
        "$className": "Folder"
      }
    },

    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "StreamingEnabled": false
      }
    },

    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "GlobalShadows": true
      }
    },

    "StarterGui": {
      "$className": "StarterGui",
      "$properties": {
        "ResetPlayerGuiOnSpawn": false
      }
    },

    "SoundService": {
      "$className": "SoundService"
    }
  }
}
