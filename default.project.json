{
  "name": "MagicFightingGame",
  "tree": {
    "$className": "DataModel",

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": {
        "$path": "src/server"
      }
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": {
          "$path": "src/client"
        }
      }
    },

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/shared"
      },
      "Data": {
        "$path": "src/data"
      },
      "Remotes": {
        "$className": "Folder"
      }
    },

    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "StreamingEnabled": false
      },
      "MagicHall": {
        "$className": "Folder"
      },
      "Arena": {
        "$className": "Folder"
      },
      "Portal": {
        "$className": "Folder"
      }
    },

    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Ambient": [0.45, 0.45, 0.5],
        "OutdoorAmbient": [0.55, 0.55, 0.6],
        "Brightness": 3,
        "ClockTime": 14,
        "ColorShift_Bottom": [0.3, 0.3, 0.35],
        "ColorShift_Top": [0.85, 0.85, 0.95],
        "EnvironmentDiffuseScale": 1,
        "EnvironmentSpecularScale": 1,
        "FogColor": [0.75, 0.8, 0.9],
        "FogEnd": 2000,
        "FogStart": 500,
        "GeographicLatitude": 30,
        "GlobalShadows": true,
        "ShadowSoftness": 0.3
      }
    },

    "StarterGui": {
      "$className": "StarterGui",
      "$properties": {
        "ResetPlayerGuiOnSpawn": false
      }
    },

    "SoundService": {
      "$className": "SoundService"
    }
  }
}
